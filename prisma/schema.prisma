// تنظیمات کلاینت و موتورها
generator client {
  provider = "prisma-client-js"
  // این خط مهم است تا با سرور لینوکس شما هماهنگ شود
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// تنظیمات اتصال به دیتابیس
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- مدل‌های نمونه (برای تست اتصال) ---

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}
