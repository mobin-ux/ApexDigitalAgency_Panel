generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==============================
// 1. ENUMS (Definitions)
// ==============================

enum Role {
  CUSTOMER
  ADMIN
  EMPLOYEE
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  CURRENT
  COMPLETED
}

// ==============================
// 2. USER & PROFILE SYSTEM
// ==============================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  
  // --- Personal Info ---
  firstName     String?
  lastName      String?
  phone         String?
  role          Role      @default(CUSTOMER)
  avatar        String?
  coverImage    String?
  
  // --- Extended Profile ---
  bio           String?
  gender        String?
  birthDate     String?
  city          String?
  country       String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // --- Financial Info ---
  adCredits     Float     @default(0)

  // --- Relations (Connecting all modules) ---
  company            Company?      // One-to-One
  
  // Project Management
  projects           Project[]     @relation("CustomerProjects")
  managedProjects    Project[]     @relation("AssignedEmployee")
  
  // Finance & Wallet
  transactions       Transaction[]
  cards              Card[]
  installments       Installment[]
  withdrawalRequests WithdrawalRequest[]
  
  // Support System
  tickets            Ticket[]
  
  // Security
  resetTokens        PasswordResetToken[]
}

model Company {
  id          String   @id @default(uuid())
  name        String
  email       String?
  website     String?
  phone       String?
  taxId       String?
  address     String?
  type        String?
  income      String?
  employees   String?
  manager     String?
  status      String   @default("Active")
  notes       String?
  logo        String?

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==============================
// 3. PROJECT MANAGEMENT
// ==============================

model Project {
  id          String        @id @default(uuid())
  name        String
  client      String?
  category    String?       @default("General")
  progress    Int           @default(0)
  startDate   DateTime      @default(now())
  
  status      ProjectStatus @default(PENDING)
  description String?
  deadline    DateTime?
  amount      Float?        @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relations
  userId      String
  user        User          @relation("CustomerProjects", fields: [userId], references: [id], onDelete: Cascade)
  
  employeeId  String?
  employee    User?         @relation("AssignedEmployee", fields: [employeeId], references: [id])

  milestones  Milestone[]
}

model Milestone {
  id        String          @id @default(uuid())
  title     String
  status    MilestoneStatus @default(PENDING)
  date      DateTime?
  
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==============================
// 4. FINANCE & WALLET
// ==============================

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String   // DEPOSIT, PAYMENT, WITHDRAWAL
  status      String   @default("COMPLETED")
  description String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Card {
  id          String   @id @default(uuid())
  type        String   // Mastercard, Visa
  last4       String
  holderName  String
  expiryDate  String   // MM/YY
  balance     Float
  limit       Float
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Installment {
  id          String   @id @default(uuid())
  project     String
  total       Float
  paid        Float
  amountDue   Float
  monthsTotal Int
  monthsPaid  Int
  nextDue     DateTime
  status      String   // active, urgent
  icon        String
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  amount      Float
  status      String   // Processing, Completed, Rejected
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==============================
// 5. SUPPORT SYSTEM
// ==============================

model Ticket {
  id          String   @id @default(uuid())
  subject     String
  status      String   @default("OPEN")
  priority    String   @default("NORMAL")
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messages    TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(uuid())
  content   String
  isAdmin   Boolean  @default(false)
  senderId  String?  // Optional: ID of specific staff member
  createdAt DateTime @default(now())

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ==============================
// 6. AUTHENTICATION
// ==============================

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}