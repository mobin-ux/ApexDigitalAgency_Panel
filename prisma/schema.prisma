generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==============================
// 1. ENUMS (Definitions)
// ==============================

enum Role {
  CUSTOMER
  ADMIN
  EMPLOYEE
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  CURRENT
  COMPLETED
}

// ==============================
// 2. USER & PROFILE SYSTEM
// ==============================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  
  // --- Personal Info ---
  firstName     String?
  lastName      String?
  phone         String?
  role          Role      @default(CUSTOMER)
  avatar        String?
  coverImage    String?
  
  // --- Extended Profile ---
  bio           String?
  gender        String?
  birthDate     String?
  city          String?
  country       String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // --- Financial Info ---
  walletBalance Float     @default(0)
  adCredits     Float     @default(0)

  // --- Relations (Connecting all modules) ---
  company             Company?       // One-to-One
  
  // Project Management
  // 1. پروژه‌هایی که کاربر مالک آنهاست (مشتری)
  projects            Project[]      @relation("CustomerProjects")
  // 2. پروژه‌هایی که کاربر مدیریت می‌کند (کارمند/ادمین)
  managedProjects     Project[]      @relation("AssignedEmployee")
  
  // Finance & Wallet
  transactions        Transaction[]
  cards               Card[]
  installments        Installment[]
  withdrawalRequests  WithdrawalRequest[]
  
  // Support System
  tickets             Ticket[]
  
  // Security
  resetTokens         PasswordResetToken[]

  // Notifications
  notifications       Notification[] 
}


model Company {
  id          String   @id @default(uuid())
  name        String
  email       String?
  website     String?
  phone       String?
  taxId       String?
  address     String?
  type        String?
  income      String?
  employees   String?
  manager     String?
  status      String   @default("Active")
  notes       String?
  logo        String?

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==============================
// 3. PROJECT MANAGEMENT
// ==============================

model Project {

  id          String      @id @default(uuid())
  name        String
  category    String      // e.g. "Web Development", "SEO"
  status      String      @default("PENDING") // IN_PROGRESS, COMPLETED, CANCELLED
  amount      Float       @default(0) 
  
  progress    Int         @default(0) 
  startDate   DateTime    @default(now())
  deadline    DateTime?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // --- روابط اصلاح شده ---
  
  // مالک پروژه (مشتری)
  userId      String
  user        User        @relation("CustomerProjects", fields: [userId], references: [id], onDelete: Cascade)

  // مدیر پروژه (کارمند) - این بخش برای رفع ارور اضافه شد
  managerId   String?     
  manager     User?       @relation("AssignedEmployee", fields: [managerId], references: [id])
  
  // مراحل پروژه
  milestones  Milestone[]

  files       ProjectFile[]
}

model Milestone {
  id        String    @id @default(uuid())
  title     String    
  status    String    
  date      DateTime? 
  
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==============================
// 4. FINANCE & WALLET
// ==============================

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String   // DEPOSIT, PAYMENT, WITHDRAWAL
  status      String   @default("COMPLETED")
  description String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Card {
  id              String   @id @default(uuid())
  type            String   // Mastercard, Visa
  last4           String
  holderName      String
  expiryDate      String   // MM/YY
  
  // فیلدهای مورد نیاز برای لاجیک Wallet.vue
  withdrawalLimit Float    @default(2500)
  withdrawalUsed  Float    @default(0)
  paymentLimit    Float    @default(5000)
  paymentUsed     Float    @default(0)
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Installment {
  id          String   @id @default(uuid())
  project     String
  total       Float
  paid        Float
  amountDue   Float
  monthsTotal Int
  monthsPaid  Int
  nextDue     DateTime
  status      String   // active, urgent
  icon        String
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  amount      Float
  status      String   // Processing, Completed, Rejected
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==============================
// 5. SUPPORT SYSTEM
// ==============================

model Ticket {
  id          String   @id @default(uuid())
  subject     String
  status      String   @default("OPEN")
  priority    String   @default("NORMAL")
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messages    TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(uuid())
  content   String
  isAdmin   Boolean  @default(false)
  senderId  String?  
  createdAt DateTime @default(now())

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ==============================
// 6. AUTHENTICATION & NOTIFICATIONS
// ==============================

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO") 
  isRead    Boolean  @default(false)
  link      String?  
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model ProjectFile {
  id        String   @id @default(uuid())
  name      String   // مثلا: "Contract.pdf"
  url       String   // لینک دانلود
  size      String   // مثلا: "2.4 MB"
  type      String   // pdf, jpg, zip
  createdAt DateTime @default(now())
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}