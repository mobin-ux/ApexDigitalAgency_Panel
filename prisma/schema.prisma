generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Or postgresql
  url      = "file:./dev.db"
}

// 1. Definition of Roles
enum Role {
  CUSTOMER
  ADMIN
  EMPLOYEE
}

// 2. Definition of Project Status
enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  role      Role     @default(CUSTOMER) // Changed from String to Enum
  status    String   @default("ACTIVE") // ACTIVE, BANNED, PENDING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  projects           Project[]     @relation("CustomerProjects") // Projects owned by customer
  managedProjects    Project[]     @relation("AssignedEmployee") // Projects managed by employee
  transactions       Transaction[]
  resetTokens        PasswordResetToken[]
}

model Project {
  id          String        @id @default(uuid())
  name        String
  client      String?
  status      ProjectStatus @default(PENDING)
  description String?
  deadline    DateTime?
  amount      Float?        @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Owner (Customer)
  userId      String
  user        User          @relation("CustomerProjects", fields: [userId], references: [id])

  // Assigned Employee (Optional)
  employeeId  String?
  employee    User?         @relation("AssignedEmployee", fields: [employeeId], references: [id])
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String
  status      String   @default("COMPLETED")
  description String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // --- اضافه کردن این دو خط برای تکمیل رابطه ---
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}