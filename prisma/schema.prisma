generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==============================
// 1. ENUMS (Definitions)
// ==============================

enum Role {
  CUSTOMER
  ADMIN
  EMPLOYEE
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  CURRENT
  COMPLETED
}

// ==============================
// 2. USER & PROFILE SYSTEM
// ==============================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  
  // --- Personal Info ---
  firstName     String?
  lastName      String?
  phone         String?
  role          Role      @default(CUSTOMER)
  avatar        String?
  coverImage    String?

  // --- Account governance (managed from the admin panel) ---
  // String (not enum) to match Project.status convention; values are
  // constrained by zod on the API surface: ACTIVE | SUSPENDED.
  // Suspended accounts are refused at login.
  status        String    @default("ACTIVE")
  // Set when an admin (or a future email flow) verifies the account.
  verifiedAt    DateTime?
  
  // --- Extended Profile ---
  bio           String?
  gender        String?
  birthDate     String?
  city          String?
  country       String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // --- Financial Info ---
  walletBalance Float     @default(0)
  adCredits     Float     @default(0)
  // When true, due installments are charged from the wallet automatically
  // (evaluated lazily on finance-dashboard load — no cron in this stack).
  autoPayInstallments Boolean @default(true)

  // --- Relations (Connecting all modules) ---
  company             Company?       // One-to-One
  creditLine          CreditLine?    // One-to-One (Apex credit product)
  
  // Project Management
  // 1. Projects the user owns (as the customer)
  projects            Project[]      @relation("CustomerProjects")
  // 2. Projects the user manages (as an employee/admin)
  managedProjects     Project[]      @relation("AssignedEmployee")
  
  // Finance & Wallet
  transactions        Transaction[]
  cards               Card[]
  installments        Installment[]
  withdrawalRequests  WithdrawalRequest[]
  invoices            Invoice[]

  // Real payment rails (ADR-015)
  paymentMethods      PaymentMethod[]
  paymentIntents      PaymentIntent[]
  payouts             Payout[]
  ledgerEntries       LedgerEntry[]

  // Files this user uploaded (ticket attachments, etc.)
  attachments         Attachment[]
  
  // Support System
  tickets             Ticket[]
  // Tickets this user handles as a support agent (admin/employee side)
  assignedTickets     Ticket[]       @relation("TicketAssignee")
  
  // Security
  resetTokens         PasswordResetToken[]

  // Notifications
  notifications       Notification[] 
}


model Company {
  id          String   @id @default(uuid())
  name        String
  email       String?
  website     String?
  phone       String?
  taxId       String?
  address     String?
  type        String?
  income      String?
  employees   String?
  manager     String?
  status      String   @default("Active")
  notes       String?
  logo        String?

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==============================
// 3. PROJECT MANAGEMENT
// ==============================

model Project {

  id          String      @id @default(uuid())
  name        String
  category    String      // e.g. "Web Development", "SEO"
  status      String      @default("PENDING") // IN_PROGRESS, COMPLETED, CANCELLED
  amount      Float       @default(0) 
  
  progress    Int         @default(0)
  startDate   DateTime    @default(now())
  deadline    DateTime?

  // --- Contract (captured by the New Order wizard) ---
  // E-signature as a data-URL image (drawn) or typed full name.
  signature   String?
  signedAt    DateTime?
  // Financing term the customer chose (12 = 0%, 24 = 1%/mo — ADR-011).
  termMonths  Int?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // --- Relations ---

  // Project owner (the customer)
  userId      String
  user        User        @relation("CustomerProjects", fields: [userId], references: [id], onDelete: Cascade)

  // Project manager (an employee/admin)
  managerId   String?
  manager     User?       @relation("AssignedEmployee", fields: [managerId], references: [id])

  // Project milestones
  milestones  Milestone[]

  files       ProjectFile[]

  // Real financing plan for this project (replaces the derived
  // presentation-only plans of ADR-010).
  installmentPlan Installment?

  invoices        Invoice[]

  // Tickets the customer explicitly linked to this project.
  relatedTickets  Ticket[]  @relation("TicketProject")
}

model Milestone {
  id        String    @id @default(uuid())
  title     String    
  status    String    
  date      DateTime? 
  
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==============================
// 4. FINANCE & WALLET
// ==============================

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String   // DEPOSIT, PAYMENT, WITHDRAWAL, REFUND, CREDIT_REPAY
  status      String   @default("COMPLETED")
  description String?
  // Spend category for expense breakdowns — the owning project's category
  // on charges (e.g. "Web Development"); null for deposits/withdrawals.
  category    String?
  // Set when this row is an installment charge.
  installmentId String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([installmentId])
}

model Card {
  id              String   @id @default(uuid())
  type            String   // Mastercard, Visa
  last4           String
  holderName      String
  expiryDate      String   // MM/YY
  
  // Limit/usage fields consumed by the Wallet page logic
  withdrawalLimit Float    @default(2500)
  withdrawalUsed  Float    @default(0)
  paymentLimit    Float    @default(5000)
  paymentUsed     Float    @default(0)

  isDefault       Boolean  @default(false)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A financing PLAN for one project (one row per plan, counters advance as
// monthly charges land). Created atomically with the project by the New
// Order wizard; charged via POST /api/finance/installments/:id/pay.
// `project` (display name) predates the FK and is kept for the admin list;
// `projectId` is the real link (nullable only for legacy/seed rows).
model Installment {
  id          String   @id @default(uuid())
  project     String
  total       Float
  paid        Float
  amountDue   Float    // amount of the NEXT charge (monthly amount until settled)
  monthsTotal Int
  monthsPaid  Int
  nextDue     DateTime
  status      String   // active, urgent, settled
  icon        String

  // --- Real plan terms (ADR-011 math, computed server-side) ---
  monthlyAmount Float  @default(0)
  termMonths    Int    @default(12)
  interestRate  Float  @default(0) // monthly rate: 0 for 12-mo, 0.01 for 24-mo

  projectId   String?  @unique
  projectRef  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextDue])
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  amount      Float
  status      String   // Processing, Completed, Rejected
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The "Apex credit" product: a revolving line the customer applies for and
// an admin approves. `used` grows when credit funds a project and shrinks
// on repayment. One line per user.
model CreditLine {
  id              String    @id @default(uuid())
  status          String    @default("PENDING") // PENDING, ACTIVE, FROZEN, REJECTED
  limit           Float     @default(0)
  used            Float     @default(0)
  requestedLimit  Float     @default(0)
  appliedAt       DateTime  @default(now())
  approvedAt      DateTime?
  nextRepayAmount Float?
  nextRepayDate   DateTime?

  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Immutable billing document issued inside the same DB transaction as the
// charge it documents (server/utils/invoices.ts). REFUND rows are negative
// credit notes. Numbering: INV-YYYY-NNNN, sequential per year.
model Invoice {
  id            String   @id @default(uuid())
  number        String   @unique
  amount        Float    // gross, GBP
  vatRate       Float    @default(0) // percent at issue time (Setting business.vat-rate)
  vatAmount     Float    @default(0)
  status        String   @default("PAID") // PAID, REFUNDED
  description   String
  issuedAt      DateTime @default(now())

  transactionId String?  @unique

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, issuedAt])
}

// ==============================
// 5. SUPPORT SYSTEM
// ==============================

model Ticket {
  id          String   @id @default(uuid())
  subject     String
  status      String   @default("OPEN")
  priority    String   @default("NORMAL")
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Support agent handling this ticket (assigned from the admin panel).
  assigneeId  String?
  assignee    User?    @relation("TicketAssignee", fields: [assigneeId], references: [id])

  // Project the customer linked this request to (optional).
  relatedProjectId String?
  relatedProject   Project? @relation("TicketProject", fields: [relatedProjectId], references: [id], onDelete: SetNull)

  // Last time the customer opened the thread — anything from staff after
  // this is "unread" in the customer inbox.
  customerLastSeenAt DateTime?

  messages    TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(uuid())
  content   String
  isAdmin   Boolean  @default(false)
  // Internal staff note: never returned by the customer-facing thread
  // endpoints, only visible inside the admin panel.
  isInternal Boolean @default(false)
  senderId  String?
  createdAt DateTime @default(now())

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  attachments Attachment[]
}

// Uploaded file attached to a ticket message. Stored on local disk under
// /public/uploads (server/utils/uploads.ts) — the util is the seam to swap
// in object storage (S3 etc.) without touching call sites.
model Attachment {
  id              String   @id @default(uuid())
  name            String   // original filename
  path            String   // public URL path, e.g. /uploads/tickets/xxx.pdf
  size            Int      // bytes
  mime            String
  createdAt       DateTime @default(now())

  uploaderId      String
  uploader        User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  ticketMessageId String?
  ticketMessage   TicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)

  @@index([ticketMessageId])
}

// ==============================
// 6. AUTHENTICATION & NOTIFICATIONS
// ==============================

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO") 
  isRead    Boolean  @default(false)
  link      String?  
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model ProjectFile {
  id        String   @id @default(uuid())
  name      String   // e.g. "Contract.pdf"
  url       String   // download link
  size      String   // e.g. "2.4 MB"
  type      String   // pdf, jpg, zip
  createdAt DateTime @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==============================
// 7. ADMIN / GOVERNANCE
// ==============================

// Immutable trail of privileged (admin) actions. Written by
// `recordAudit()` (server/utils/audit.ts) on every admin mutation.
// `actorEmail` is denormalized so the trail stays readable even if
// the actor account is later deleted; `metadata` is a JSON string
// (SQLite has no native Json column type).
// Application-wide configuration managed from the admin Settings page.
// One row per key; `value` is JSON-stringified (SQLite has no Json type)
// so booleans/numbers/objects round-trip losslessly. `group` drives the
// admin UI sections (general | business | finance | support | integrations).
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
  updatedBy String?  // denormalized admin email, informational only
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorEmail String
  action     String   // dot-namespaced, e.g. "admin.user.update"
  targetType String   // "User", "Project", "Ticket", ...
  targetId   String?
  metadata   String?  // JSON-stringified context (before/after, request details)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ==============================
// 8. PAYMENT RAILS (ADR-015)
// ==============================
// Everything below stores money as INTEGER MINOR UNITS (pence) — never Float.
// Conversion at the boundary lives in server/utils/money.ts. The legacy Float
// columns above are unchanged on purpose (own migration phase).

/// A payment instrument held at a provider. We store provider TOKENS and
/// display metadata only — never a PAN or CVV (PCI DSS SAQ-A, ADR-015 §8).
model PaymentMethod {
  id                 String   @id @default(uuid())
  provider           String   // stripe | gocardless | paypal | truelayer | mock
  kind               String   // card | bacs_debit | paypal | open_banking
  /// Provider-side customer handle (Stripe cus_…, GoCardless CU…).
  providerCustomerId String?
  /// Provider-side instrument handle (Stripe pm_…, GoCardless mandate MD…).
  providerMethodId   String
  /// Display metadata returned by the provider — safe to render.
  brand              String?  // visa, mastercard, or the bank name
  last4              String?
  expMonth           Int?
  expYear            Int?
  accountHolder      String?
  /// Direct-debit lifecycle: pending_submission | submitted | active | cancelled | failed
  mandateStatus      String?
  status             String   @default("active") // active | removed
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  intents            PaymentIntent[]

  @@unique([provider, providerMethodId])
  @@index([userId, status])
}

/// One attempt to move real money. Our `reference` is the idempotency anchor:
/// it is generated before the provider is called and replayed on retry, so a
/// dropped response can never double-charge.
model PaymentIntent {
  id               String    @id @default(uuid())
  reference        String    @unique // APX-PI-XXXXXXXX, shown to support
  provider         String
  providerIntentId String?
  /// wallet_topup | order_deposit | installment | credit_repay
  purpose          String
  /// requires_action | processing | succeeded | failed | cancelled
  status           String    @default("requires_action")
  /// MINOR UNITS (pence).
  amount           Int
  currency         String    @default("GBP")
  /// Provider fee in minor units, filled from the webhook when known.
  feeAmount        Int       @default(0)
  /// Sent to the provider as its idempotency key.
  idempotencyKey   String    @unique
  failureCode      String?
  failureMessage   String?
  /// JSON blob of our own context (never provider secrets).
  metadata         String?
  settledAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentMethodId  String?
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  /// Set when this intent collects a scheduled installment.
  installmentId    String?
  projectId        String?

  refunds          Refund[]
  ledgerEntries    LedgerEntry[]

  @@unique([provider, providerIntentId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([installmentId])
}

model Refund {
  id               String   @id @default(uuid())
  provider         String
  providerRefundId String?
  amount           Int      // minor units
  reason           String?
  status           String   @default("processing") // processing | succeeded | failed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  paymentIntentId  String
  paymentIntent    PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  /// Admin who issued it (audited separately in AuditLog).
  initiatedById    String?

  @@unique([provider, providerRefundId])
  @@index([paymentIntentId])
}

/// Money leaving the platform to a customer (withdrawal fulfilment).
model Payout {
  id                  String   @id @default(uuid())
  provider            String
  providerPayoutId    String?
  amount              Int      // minor units
  currency            String   @default("GBP")
  status              String   @default("pending") // pending | paid | failed | cancelled
  failureMessage      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The customer request this payout fulfils.
  withdrawalRequestId String?  @unique

  @@unique([provider, providerPayoutId])
  @@index([userId, createdAt])
}

/// Raw provider webhooks. The unique constraint IS the idempotency guarantee:
/// Stripe and GoCardless both deliver at-least-once with retries for up to
/// 72h, so duplicates are normal traffic (ADR-015 §7).
model WebhookEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String
  type            String
  /// Verbatim verified payload — handlers are re-runnable from this.
  payload         String
  signatureValid  Boolean   @default(false)
  status          String    @default("received") // received | processed | failed | ignored
  attempts        Int       @default(0)
  lastError       String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([type])
}

/// Double-entry ledger — the reconciliation source of truth. Every journal
/// (rows sharing `journalId`) must balance: Σ DEBIT == Σ CREDIT.
/// PROVIDER_CLEARING must track the provider's own reported balance.
model LedgerEntry {
  id              String   @id @default(uuid())
  /// Groups the balanced rows of one economic event.
  journalId       String
  /// USER_WALLET | PROVIDER_CLEARING | REVENUE | VAT | CREDIT_RECEIVABLE | FEES
  account         String
  direction       String   // DEBIT | CREDIT
  amount          Int      // minor units, always positive
  currency        String   @default("GBP")
  description     String
  createdAt       DateTime @default(now())

  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@index([journalId])
  @@index([account, createdAt])
  @@index([userId, createdAt])
}