# =============================================================================
# Apex Digi — environment template
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Everything here is optional for local development: with no payment
# credentials the provider registry serves the deterministic `mock` rail, so
# the whole app works offline. That is deliberate — a missing key must never
# silently become a real charge (ADR-015 §9).
# =============================================================================

# --- Core -------------------------------------------------------------------
# Signs the auth_token JWT. Generate with: openssl rand -hex 32
NUXT_JWT_SECRET=

# Public origin, used to build provider return/webhook URLs.
NUXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Stripe — primary gateway (cards, wallets, payouts) ----------------------
# Dashboard → Developers → API keys.  Test keys start sk_test_ / pk_test_.
# The registry refuses to use a LIVE key unless Admin → Settings →
# `payments.live-mode` is also enabled.
NUXT_PAYMENTS_STRIPE_SECRET_KEY=
NUXT_PUBLIC_PAYMENTS_STRIPE_PUBLISHABLE_KEY=

# Dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_…).
# Local testing:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Subscribe to: payment_intent.succeeded, payment_intent.payment_failed,
#               payment_intent.processing, charge.refunded, mandate.updated,
#               payout.paid, payout.failed
NUXT_PAYMENTS_STRIPE_WEBHOOK_SECRET=


# --- GoCardless — Bacs Direct Debit, the installment rail --------------------
# Sandbox: https://manage-sandbox.gocardless.com → Developers → Access tokens.
# Sandbox tokens start `sandbox_`; live tokens start `live_` (which also flips
# the adapter to the production API host).
NUXT_PAYMENTS_GOCARDLESS_ACCESS_TOKEN=

# Developers → Webhook endpoints → the secret you set when creating it.
# Subscribe to: payments.confirmed, payments.failed, payments.paid_out,
#               mandates.active, mandates.cancelled, mandates.failed,
#               refunds.paid, payouts.paid
NUXT_PAYMENTS_GOCARDLESS_WEBHOOK_SECRET=


# --- PayPal — optional top-up rail (never installments) ----------------------
# https://developer.paypal.com → Apps & Credentials → Sandbox.
NUXT_PAYMENTS_PAYPAL_CLIENT_ID=
NUXT_PUBLIC_PAYMENTS_PAYPAL_CLIENT_ID=
NUXT_PAYMENTS_PAYPAL_CLIENT_SECRET=
# Webhooks → your endpoint → Webhook ID (PayPal verifies by API, not HMAC).
NUXT_PAYMENTS_PAYPAL_WEBHOOK_ID=
NUXT_PAYMENTS_PAYPAL_ENV=sandbox


# --- Observability -----------------------------------------------------------
# debug | info | warn | error   (default: debug in dev, info in production)
LOG_LEVEL=

# Uploads and encryption (already read by the server; documented here for deploys).
NUXT_UPLOAD_DIR=
NUXT_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Lending switches (ADR-025) — leave unset (off) unless the owner has
# confirmed the lending position. Never switchable from the admin console.
# ---------------------------------------------------------------------------
# The legacy 24-month plan at 1% a month (ADR-011). Off: no such plan can be created.
NUXT_LENDING_INTEREST_BEARING_PLANS=
# Approving credit applications, raising a line's limit, releasing a held line.
# Off: staff can still decline, freeze and lower.
NUXT_LENDING_CREDIT_DECISIONS=
NUXT_COMPANIES_HOUSE_KEY=

# ---------------------------------------------------------------------------
# Outgoing email (ADR-022): Resend (https://resend.com), the same provider
# the public site's contact form uses; one API key can serve both apps.
# ---------------------------------------------------------------------------
# With either key empty nothing is sent: messages are queued, marked failed
# with the reason, and every screen says so (invites hand over the link,
# the recover page says reset-by-email is unavailable). Set both together.
NUXT_MAIL_RESEND_API_KEY=
# Must be an address on a domain verified with Resend.
NUXT_MAIL_FROM=Apex Digital Agency <no-reply@apexdigi.co.uk>
# Links in emails are built from NUXT_PUBLIC_SITE_URL (above): the panel's
# public https origin in production.

# ---------------------------------------------------------------------------
# The public site the console's Website screens publish to (ADR-026).
# ---------------------------------------------------------------------------
# Where this server reads the site's code baseline (Import) and asks it to drop
# its content cache after a publish. Both apps run on one box: a loopback URL.
NUXT_WEBSITE_SITE_URL=http://127.0.0.1:3100
# A long random value; the site's NUXT_CMS_REVALIDATE_SECRET must be the same.
# Without it publishing still works and the site catches up within a minute.
NUXT_WEBSITE_REVALIDATE_SECRET=
# The site's public address, for the 30-minute draft preview links staff open.
NUXT_WEBSITE_PUBLIC_URL=https://apexdigi.co.uk
# Media library files (images and PDFs on the website). Keep it outside the
# deployed bundle so a deploy cannot wipe it. Default: .data/site-media.
NUXT_WEBSITE_MEDIA_DIR=/opt/apex/site-media
# Checks the signature on contact-form messages the site forwards to
# Website > Enquiries. A long random value; the site's NUXT_CMS_ENQUIRY_SECRET
# must be the same. Unset: the site's forwards are refused (503) and messages
# arrive by email only, if the site's contact mail is configured. A key
# derived from it also checks the visit totals the site sends to Analytics
# once a minute; unset, those are refused too and Analytics stays empty.
NUXT_WEBSITE_ENQUIRY_SECRET=

# ---------------------------------------------------------------------------
# Platform log (shared/log.ts). One JSON line per event, to stdout and to a
# file per day. Passwords, tokens, codes and message bodies never reach it.
# ---------------------------------------------------------------------------
# Where the daily files go. Default: .data/logs beside the process.
NUXT_LOG_DIR=/opt/apex/logs
# debug | info | warn | error. Default: info (debug in development).
NUXT_LOG_LEVEL=info
# Files older than this many days are deleted by the daily logs:prune task.
NUXT_LOG_RETENTION_DAYS=30
# A request slower than this is logged as a warning (milliseconds).
NUXT_LOG_SLOW_REQUEST_MS=1500
# A database query slower than this is a db.slow warning (milliseconds).
NUXT_LOG_SLOW_QUERY_MS=200
# The public site's log directory, so System > Logs shows both apps. Unset:
# the console shows its own lines only (development reads web/.data/logs).
NUXT_LOG_SITE_DIR=/opt/apex-web/logs
