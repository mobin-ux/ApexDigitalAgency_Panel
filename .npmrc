# مخزن اصلی پکیج‌ها (رانفلر - عالی برای ایران)
registry=https://mirror-npm.runflare.com/

# تنظیمات حیاتی برای دانلود موتور دیتابیس (Prisma)
prisma_engines_mirror=https://registry.npmmirror.com/-/binary/prisma/
sharp_binary_host=https://registry.npmmirror.com/-/binary/sharp/
sharp_libvips_binary_host=https://registry.npmmirror.com/-/binary/sharp-libvips/

# غیرفعال کردن SSL و افزایش تایم‌اوت (حیاتی برای جلوگیری از قطع شدن)
strict-ssl=false
fetch-retries=10
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000