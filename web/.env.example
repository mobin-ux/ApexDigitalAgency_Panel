# Public site origin — drives canonical URLs, sitemap, robots and JSON-LD.
# Leave unset in development. In production this MUST be the live origin.
NUXT_PUBLIC_SITE_URL=https://apexdigi.co.uk

# Set to "production" on the live server only. Any other value makes
# robots.txt disallow everything and adds noindex, so staging is never indexed.
NUXT_SITE_ENV=production

# Contact form delivery (server-only). Messages are emailed to CONTACT_TO via
# Resend (https://resend.com); FROM must be on a domain verified there. While
# any of the three is empty the form says it could not send and offers the
# visitor's own email client instead.
NUXT_CONTACT_RESEND_API_KEY=
NUXT_CONTACT_TO=ceo@digiapex.co.uk
NUXT_CONTACT_FROM=Apex website <website@apexdigi.co.uk>

# The admin console that publishes this site's content (ADR-026), read server
# to server only. Unset: every page renders its code baseline, as it always has.
# In production the panel is on the same box: a loopback URL.
NUXT_CMS_URL=http://127.0.0.1:3000
# The bearer the panel sends after a publish; the same value as the panel's
# NUXT_WEBSITE_REVALIDATE_SECRET. Unset: revalidation answers 503 and pages
# pick up a publish within a minute.
NUXT_CMS_REVALIDATE_SECRET=
# Extra console origins allowed to frame /preview/** in the editor, comma
# separated. Read at BUILD time (route rules are fixed then). The production
# panel hosts are already allowed, and a dev build allows localhost:3000.
CMS_PANEL_ORIGINS=
# Signs each contact message forwarded to the console's Enquiries screen; the
# same value as the panel's NUXT_WEBSITE_ENQUIRY_SECRET. With this and
# NUXT_CMS_URL set, a message counts as delivered once it is stored there,
# even when the NUXT_CONTACT_* email keys are empty. It also signs (through a
# derived key) the visit totals sent to the console's Analytics each minute;
# unset, the site counts nothing.
NUXT_CMS_ENQUIRY_SECRET=
